{
  "id": "text-only",
  "name": "Só texto na tela",
  "summary": "One still image or clip, a 1-2 line text hook from frame 0, a slow push, one impact zoom with a hit around 2.5 s, whoosh on the text entrance. For hook families without speech (Kallaway family 4).",
  "slots": {
    "id": { "type": "string", "required": true },
    "background": { "type": "media-path", "required": true, "description": "image or video file" },
    "background_kind": { "type": "image|video", "default": "image" },
    "hook_lines": { "type": "string[]", "required": true, "description": "exact on-screen text, one entry per line, max 2" },
    "highlight_words": { "type": "string[]", "default": [] },
    "duration": { "type": "seconds", "default": 7 },
    "text_y": { "type": "px", "default": 380, "description": "centre of the text block; keep it off the eyes and mouth" },
    "font_px": { "type": "px", "default": 66 },
    "impact_at": { "type": "seconds", "default": 2.5 },
    "platforms": { "type": "platform[]", "default": ["instagram_reels", "tiktok"] },
    "protect_regions": { "type": "rect[]", "default": [] },
    "focus": { "type": "point", "default": { "x": 0.5, "y": 0.45 } },
    "visual_note": { "type": "string", "required": true, "description": "what the frame shows, for the triple alignment" },
    "music": { "type": "audio-path", "default": null },
    "music_mood": { "type": "calm|chill-beat|emotional|groove|hiphop|upbeat", "default": null, "description": "music from the squad library (assets/music/index.json), first track of the mood; music (a path) wins when both are set" },
    "music_gain_db": { "type": "dB", "default": -12, "description": "fixed music gain before the -14 LUFS normalisation (no voice to duck under)" },
    "alignment_text": { "type": "string", "required": true, "description": "what the text promises; the batch fills it from hook_lines" }
  },
  "hooks_timeline": [
    { "at": 0, "hook": "text_line_stagger", "why": "the hook text is readable on frame 0; line 2 lands 0.35 s later" },
    { "at": 0, "hook": "whoosh", "why": "sound marks the text entrance" },
    { "at": 0, "hook": "slow_push", "why": "a still image keeps moving for the whole video" },
    { "at": "impact_at", "hook": "impact_zoom", "why": "pattern interrupt inside the 2-3 s window" },
    { "at": "impact_at", "hook": "hit", "why": "sound and zoom land on the same frame" },
    { "at": 0, "hook": "word_highlight", "why": "only when highlight_words is set: colours the payoff words" }
  ],
  "spec": {
    "spec_version": 1,
    "id": "$slot:id",
    "canvas": { "width": 1080, "height": 1920, "fps": 30 },
    "duration": "$slot:duration",
    "platforms": "$slot:platforms",
    "layers": [
      { "id": "bg", "src": "$slot:background", "kind": "$slot:background_kind", "start": 0, "duration": "$slot:duration", "fit": "cover" }
    ],
    "camera": [
      { "type": "push", "start": 0, "end": "$slot:duration", "from": 1.0, "to": 1.08 },
      { "type": "impact", "at": "$slot:impact_at", "amount": 0.05, "attack": 0.09, "release": 0.4 }
    ],
    "camera_focus": "$slot:focus",
    "flashes": [],
    "texts": [
      {
        "id": "hook",
        "role": "hook",
        "lines": "$slot:hook_lines",
        "start": 0,
        "end": "$slot:duration",
        "x": 540,
        "y": "$slot:text_y",
        "animation": "line_stagger",
        "stagger": 0.35,
        "highlight_words": "$slot:highlight_words",
        "fit_width": true,
        "style": {
          "font_family": "Inter",
          "font_px": "$slot:font_px",
          "bold": true,
          "color": "#ffffff",
          "highlight_color": "#ffd23f",
          "outline_px": 4,
          "outline_color": "#000000",
          "shadow_px": 2
        }
      }
    ],
    "audio": {
      "music": { "path": "$slot:music", "mood": "$slot:music_mood", "gain_db": "$slot:music_gain_db" },
      "sfx": [
        { "src": "@sfx:whoosh", "at": 0, "gain_db": -7, "hook": "whoosh" },
        { "src": "@sfx:hit", "at": "$slot:impact_at", "gain_db": -6, "hook": "hit", "anchor": true }
      ],
      "loudness": { "target_lufs": -14, "true_peak_db": -1 }
    },
    "protect_regions": "$slot:protect_regions",
    "hooks_applied": [
      { "hook": "text_line_stagger", "at": 0, "why": "hook text readable on frame 0, second line lands 0.35 s later" },
      { "hook": "slow_push", "at": 0, "why": "still image keeps moving: 1.00 to 1.08 over the whole video" },
      { "hook": "impact_zoom", "at": "$slot:impact_at", "why": "pattern interrupt inside the 2-3 s window" },
      { "hook": "whoosh", "at": 0, "why": "sound marks the text entrance" },
      { "hook": "hit", "at": "$slot:impact_at", "why": "sound lands on the zoom frame" }
    ],
    "alignment": {
      "text": "$slot:alignment_text",
      "visual": "$slot:visual_note",
      "audio": "whoosh on the text entrance, hit on the impact zoom; platform music added in the app"
    },
    "frame_at": 1.5,
    "output": { "crf": 20, "preset": "medium" }
  }
}

{
  "id": "pov-app-screen",
  "name": "POV com tela do app",
  "summary": "POV text hook over a person or scene; at screen_at the app screen recording drops into a framed slot with a whoosh and an impact zoom, and stays as proof through the holding zone (3-10 s).",
  "slots": {
    "id": { "type": "string", "required": true },
    "background": { "type": "media-path", "required": true },
    "background_kind": { "type": "image|video", "default": "image" },
    "app_screen": { "type": "media-path", "required": true, "description": "screen recording (video) or screenshot of the real app; never a mock-up passed off as the product; while the real screen does not exist, a placeholder labelled as such (examples/media/app-screen-placeholder.png or cli.ts placeholder-screen)" },
    "app_screen_kind": { "type": "image|video", "default": "video" },
    "hook_lines": { "type": "string[]", "required": true },
    "highlight_words": { "type": "string[]", "default": [] },
    "duration": { "type": "seconds", "default": 9 },
    "screen_at": { "type": "seconds", "default": 2.5 },
    "screen_duration": { "type": "seconds", "default": 6.5, "description": "duration - screen_at" },
    "text_y": { "type": "px", "default": 340 },
    "font_px": { "type": "px", "default": 64 },
    "platforms": { "type": "platform[]", "default": ["instagram_reels", "tiktok"] },
    "protect_regions": { "type": "rect[]", "default": [] },
    "focus": { "type": "point", "default": { "x": 0.5, "y": 0.45 } },
    "visual_note": { "type": "string", "required": true },
    "alignment_text": { "type": "string", "required": true },
    "music": { "type": "audio-path", "default": null },
    "music_mood": { "type": "calm|chill-beat|emotional|groove|hiphop|upbeat", "default": null, "description": "music from the squad library (assets/music/index.json), first track of the mood; music (a path) wins when both are set" },
    "music_gain_db": { "type": "dB", "default": -12, "description": "fixed music gain before the -14 LUFS normalisation (no voice to duck under)" }
  },
  "hooks_timeline": [
    { "at": 0, "hook": "text_pop_in", "why": "POV text readable on frame 0" },
    { "at": 0, "hook": "slow_push", "why": "keeps the first shot alive" },
    { "at": "screen_at", "hook": "screen_slot", "why": "proof inside the holding zone" },
    { "at": "screen_at", "hook": "whoosh", "why": "marks the layout change" },
    { "at": "screen_at", "hook": "impact_zoom", "why": "the slot lands with a punch" }
  ],
  "spec": {
    "spec_version": 1,
    "id": "$slot:id",
    "canvas": { "width": 1080, "height": 1920, "fps": 30 },
    "duration": "$slot:duration",
    "platforms": "$slot:platforms",
    "layers": [
      { "id": "bg", "src": "$slot:background", "kind": "$slot:background_kind", "start": 0, "duration": "$slot:duration", "fit": "cover" },
      { "id": "app", "src": "$slot:app_screen", "kind": "$slot:app_screen_kind", "start": "$slot:screen_at", "duration": "$slot:screen_duration",
        "rect": { "x": 230, "y": 500, "w": 620, "h": 1100 }, "fit": "cover", "border_px": 6, "border_color": "white" }
    ],
    "camera": [
      { "type": "push", "start": 0, "end": "$slot:duration", "from": 1.0, "to": 1.06 },
      { "type": "impact", "at": "$slot:screen_at", "amount": 0.04, "attack": 0.08, "release": 0.35 }
    ],
    "camera_focus": "$slot:focus",
    "flashes": [],
    "texts": [
      {
        "id": "hook", "role": "hook", "lines": "$slot:hook_lines", "start": 0, "end": "$slot:duration",
        "x": 540, "y": "$slot:text_y", "animation": "pop_in", "highlight_words": "$slot:highlight_words", "fit_width": true,
        "style": { "font_family": "Inter", "font_px": "$slot:font_px", "bold": true, "color": "#ffffff", "highlight_color": "#ffd23f",
          "outline_px": 4, "outline_color": "#000000", "shadow_px": 2 }
      }
    ],
    "audio": {
      "music": { "path": "$slot:music", "mood": "$slot:music_mood", "gain_db": "$slot:music_gain_db" },
      "sfx": [
        { "src": "@sfx:whoosh", "at": "$slot:screen_at", "gain_db": -7, "hook": "whoosh", "anchor": true }
      ],
      "loudness": { "target_lufs": -14, "true_peak_db": -1 }
    },
    "protect_regions": "$slot:protect_regions",
    "hooks_applied": [
      { "hook": "text_pop_in", "at": 0, "why": "POV text readable on frame 0" },
      { "hook": "slow_push", "at": 0, "why": "keeps the first shot alive" },
      { "hook": "screen_slot", "at": "$slot:screen_at", "why": "proof inside the holding zone (3-10 s)" },
      { "hook": "whoosh", "at": "$slot:screen_at", "why": "marks the layout change; file peak aligned to the cut" },
      { "hook": "impact_zoom", "at": "$slot:screen_at", "why": "the slot lands with a punch" }
    ],
    "alignment": { "text": "$slot:alignment_text", "visual": "$slot:visual_note", "audio": "whoosh on the app screen entrance; platform music or the bed in the spec" },
    "frame_at": "=$slot:screen_at + 1",
    "output": { "crf": 20, "preset": "medium" }
  }
}
